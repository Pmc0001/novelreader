<?xml version="1.0" encoding="utf-8"?>
<!-- 方案B Hero 背景：暖色纸张渐变 + 暖棕/蜜桃双色径向光晕，与页面背景衔接 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 底层：暖色纸张垂直渐变 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FFF7F2E9"
                android:centerColor="#FFEFE3D0"
                android:endColor="#10E6D8C2"
                android:type="linear" />
        </shape>
    </item>

    <!-- 顶部居中偏左：暖棕光晕 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="520"
                android:centerX="0.35"
                android:centerY="0.18"
                android:startColor="#66D9B98C"
                android:endColor="#00D9B98C" />
        </shape>
    </item>

    <!-- 顶部居中偏右：暖蜜桃光晕 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="480"
                android:centerX="0.7"
                android:centerY="0.1"
                android:startColor="#55E8C9A0"
                android:endColor="#00E8C9A0" />
        </shape>
    </item>

    <!-- 底部渐隐：过渡到页面正文色 -->
    <item android:gravity="bottom">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#00E6D8C2"
                android:endColor="#FFE6D8C2"
                android:type="linear" />
        </shape>
    </item>

</layer-list>
