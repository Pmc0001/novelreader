<?xml version="1.0" encoding="utf-8"?>
<!-- 方案B Tab 容器：暖色玻璃胶囊底（顶部渐隐，避免与浅色背景交界硬边） -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#00C9A77C"
        android:centerColor="#14C9A77C"
        android:endColor="#14C9A77C"
        android:type="linear" />
    <corners android:radius="24dp" />
</shape>
