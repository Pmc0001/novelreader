<?xml version="1.0" encoding="utf-8"?>
<!-- 方案B 品牌徽章：暖棕光晕环 + 暖白玻璃芯 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 外层：暖棕径向光晕 -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="48"
                android:centerX="0.5"
                android:centerY="0.4"
                android:startColor="#CCE0B080"
                android:endColor="#00E0B080" />
        </shape>
    </item>

    <!-- 内层：暖白玻璃芯，模拟磨砂质感 -->
    <item android:left="6dp" android:right="6dp" android:top="6dp" android:bottom="6dp">
        <shape android:shape="oval">
            <solid android:color="#CCFFFDF8" />
            <stroke
                android:width="1dp"
                android:color="#80C9A77C" />
        </shape>
    </item>

</layer-list>
