<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/reading_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ReadingActivity">

    <com.example.novelreader.ReadingView
        android:id="@+id/reading_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="60dp"
        android:paddingBottom="60dp" />

    <!-- 高级加载视图 -->
    <com.example.novelreader.PremiumLoadingView
        android:id="@+id/premium_loading_view"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Top Bar Gradient -->
    <View
        android:id="@+id/top_bar_gradient"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_gradient_top"
        android:visibility="gone" />

    <!-- Top Bar Container (fills status bar gap + bar) -->
    <LinearLayout
        android:id="@+id/top_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:background="@color/topBarOverlay"
        android:visibility="gone">

        <View
            android:id="@+id/status_bar_spacer"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@android:color/transparent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_button_outline"
                android:contentDescription="返回"
                android:src="@drawable/ic_back"
                android:padding="10dp"
                app:tint="@android:color/white"
                android:layout_marginStart="4dp" />

            <TextView
                android:id="@+id/btn_toc"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="目录"
                android:textSize="15sp"
                android:textColor="@android:color/white"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/bg_button_outline"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@android:color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginHorizontal="12dp"
                android:text="示例小说" />

            <ImageButton
                android:id="@+id/btn_load_url"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_button_outline"
                android:contentDescription="加载URL"
                android:src="@drawable/ic_url"
                android:padding="10dp"
                app:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/btn_night_mode"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_button_outline"
                android:contentDescription="夜间模式"
                android:src="@drawable/ic_night_mode"
                android:padding="10dp"
                app:tint="@android:color/white"
                android:layout_marginEnd="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Bar Gradient -->
    <View
        android:id="@+id/bottom_bar_gradient"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_gradient_bottom"
        android:visibility="gone" />

    <!-- Bottom Bar -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/bottomBarOverlay"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_progress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:alpha="0.8"
                android:text="阅读进度 0%" />

            <TextView
                android:id="@+id/tv_page_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:alpha="0.8"
                android:text="1 / 1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/btn_prev_chapter"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="上一章"
                android:textSize="15sp"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_button_outline"
                android:layout_marginEnd="8dp" />

            <ImageButton
                android:id="@+id/btn_settings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_button_outline"
                android:contentDescription="设置"
                android:src="@drawable/ic_settings"
                android:padding="10dp"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/btn_next_chapter"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="下一章"
                android:textSize="15sp"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_button_outline"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 目录遮罩层 -->
    <View
        android:id="@+id/toc_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlayDim"
        android:visibility="gone" />

    <!-- 目录侧边抽屉 -->
    <LinearLayout
        android:id="@+id/toc_drawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@color/bgPage"
        android:translationX="-300dp"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/colorPrimary"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="目录"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/toc_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="关闭"
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:alpha="0.8"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/toc_loading"
            style="@android:style/Widget.ProgressBar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:layout_marginTop="32dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/toc_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="未找到目录"
            android:textSize="14sp"
            android:textColor="@color/textSecondary"
            android:layout_marginTop="32dp"
            android:visibility="gone" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/toc_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp" />
        </ScrollView>
    </LinearLayout>

</FrameLayout>
